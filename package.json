{
  "name": "TimeTrackerAPI",
  "version": "1.0.0",
  "description": "Nodejs version of TimeTrackerAPI",
  "main": "server.js",
  "keywords": [
    "nodejs",
    "crud",
    "postgresql",
    "TimeTracker"
  ],
  "scripts": {
    "start": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint app/ server.js tests/",
    "lint:fix": "eslint --fix app/ server.js tests/",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "migrate:status": "sequelize-cli db:migrate:status",
    "migrate:generate": "sequelize-cli migration:generate --name"
  },
  "author": "https://github.com/CryptoJones",
  "license": "Apache-2.0",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-asyncify": "^1.0.1",
    "express-promise-router": "^4.1.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "supertest": "^7.2.2",
    "vitest": "^4.1.6"
  }
}
